# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (or mongodb://127.0.0.1:27017/transitpulse for a local server)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/transitpulse

# Long random strings. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
QR_SIGNING_SECRET=change-me-too

# Mock payment gateway: chance (0-1) that a normal card/wallet payment succeeds.
# Card 4242 4242 4242 4242 always succeeds, 4000 0000 0000 0002 always fails.
PAYMENT_SUCCESS_RATE=0.9
